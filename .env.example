# ============================================================
# javSpy 运行配置模板
# 使用方法：复制本文件为 .env（与 docker-compose.yml 同目录），
# 填好真实值后 `docker compose up -d`。.env 已被 .gitignore 忽略，不会进仓库。
# ============================================================

# ---- 镜像版本：latest 或 sha-xxxxxx（回滚用） ----
JAVSPY_TAG=latest

# ---- MariaDB（数据库在 NAS 本机就用 NAS 局域网 IP） ----
DB_HOST=192.168.0.108
DB_PORT=33306
DB_NAME=javspy
DB_USER=root
DB_PASSWORD=change-me
DB_POOL_SIZE=20

# ---- Redis（MyBatis 缓存 / ShedLock） ----
REDIS_HOST=192.168.0.108
REDIS_PORT=6379
REDIS_PASSWORD=

# ---- Emby ----
EMBY_ENABLED=true
EMBY_URL=http://192.168.0.108:28096
EMBY_API_KEY=change-me
# Emby 去重页“永久删除”的管理员令牌；留空时只能查看
EMBY_DELETE_ADMIN_TOKEN=

# ---- javbus-api ----
JAVBUS_API_URL=http://192.168.0.108:33000
JAVBUS_API_TOKEN=
JAVBUS_API_PROXY_ENABLED=false
JAVBUS_API_PROXY_HOST=127.0.0.1
JAVBUS_API_PROXY_PORT=7890

# ---- 图片存储 ----
# 容器内路径固定为 /pic，由 docker-compose.yml 的 volumes 挂载
IMAGE_STORAGE_PATH=/pic
# 宿主机上的图片目录（飞牛存储空间路径，按实际情况修改）
PIC_DIR=/vol1/1000/pic

# ---- 其它 ----
# 生产环境不建议打印全部 SQL，排查问题时改成 stdout
MYBATIS_LOG_IMPL=org.apache.ibatis.logging.nologging.NoLoggingImpl
JAVA_TOOL_OPTIONS=-Xms256m -Xmx512m -Duser.timezone=Asia/Shanghai
